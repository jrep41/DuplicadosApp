<Application x:Class="DuplicadosApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Índice 0: paleta de color intercambiable en caliente (claro/oscuro) -->
                <ResourceDictionary Source="Themes/LightPalette.xaml" />
                <!-- Índice 1: tipografía, iconos y plantillas de controles -->
                <ResourceDictionary Source="Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
